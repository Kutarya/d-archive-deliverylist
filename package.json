{
  "name": "fatura-atolyesi",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "Offline document archive: from photos to Excel with formulas",
  "author": "Invoice Atelier",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-reader.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "pack:win": "npm run build && node scripts/stage-desktop.mjs && node scripts/package-windows.mjs",
    "sync:android": "npm run build && cap sync android",
    "test": "tsx --test tests/*.test.ts",
    "test:languages": "node scripts/qa-languages.cjs",
    "test:android:system": "node scripts/qa-mobile-system.cjs"
  },
  "build": {
    "appId": "com.faturaatolyesi.app",
    "productName": "Invoice Atelier",
    "directories": {
      "output": "release/windows",
      "app": "packaging/app"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Invoice-Atelier-${version}.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@paddleocr/paddleocr-js": "0.4.2",
    "exceljs": "^4.4.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "onnxruntime-web": "1.24.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
